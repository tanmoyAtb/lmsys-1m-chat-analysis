# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- Hugging Face (lmsys/lmsys-chat-1m is a gated dataset) ---
HF_TOKEN=

# --- OpenAI / OpenAI-compatible API ---
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible endpoint (Azure, vLLM, OpenRouter, ...)
OPENAI_BASE_URL=

# Model used for LLM-based analysis (classification, labeling, summaries)
OPENAI_MODEL=gpt-5-mini
# Model used for embeddings (clustering, similarity)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
